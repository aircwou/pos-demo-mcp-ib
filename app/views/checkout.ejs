<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>POS Demo — Checkout</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
        .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center; }
        .card h3 { margin: 0 0 0.25rem; font-size: 1rem; }
        .meta { color: #666; font-size: 0.85rem; }
        button { cursor: pointer; }
        a.button, button.primary { background: #111; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-size: 0.9rem; }
        button.qty { background: #eee; border: 1px solid #ccc; border-radius: 4px; width: 1.8rem; height: 1.8rem; }
        .who { display: flex; align-items: center; gap: 0.5rem; }
        .avatar { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
        .layout { display: flex; gap: 2rem; align-items: flex-start; }
        .catalog { flex: 2; }
        .cart { flex: 1; border: 1px solid #ddd; border-radius: 8px; padding: 1rem; position: sticky; top: 1rem; }
        .cart h2 { margin-top: 0; font-size: 1.1rem; }
        .cart-line { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem; }
        .cart-total { font-weight: bold; border-top: 1px solid #ddd; padding-top: 0.5rem; margin-top: 0.5rem; }
        .category-label { color: #999; text-transform: uppercase; font-size: 0.75rem; margin: 1rem 0 0.4rem; letter-spacing: 0.05em; }
        #status { margin-top: 0.75rem; font-size: 0.9rem; }
    </style>
</head>
<body>
    <header>
        <h1>🛒 POS Demo</h1>
        <span class="who">
            <% if (user.picture) { %><img class="avatar" src="<%= user.picture %>" alt=""><% } %>
            Signed in as <%= user.name || user.email %> (<%= user.role %>)
            · <a href="/sales/mine">My sales</a>
            <% if (user.role === 'MANAGER') { %> · <a href="/manager">Manager dashboard</a><% } %>
            · <a href="/logout">Sign out</a>
        </span>
    </header>

    <div class="layout">
        <div class="catalog">
            <%
                let lastCategory = null;
                products.forEach(p => {
                    if (p.category !== lastCategory) { lastCategory = p.category; %>
                        <div class="category-label"><%= p.category %></div>
                    <% }
            %>
                <div class="card">
                    <div>
                        <h3><%= p.name %></h3>
                        <div class="meta">$<%= (p.price_cents / 100).toFixed(2) %> · <%= p.stock_qty %> in stock</div>
                    </div>
                    <button class="primary" onclick="addToCart(<%= p.id %>, '<%= p.name.replace(/'/g, "\\'") %>', <%= p.price_cents %>, <%= p.stock_qty %>)">Add</button>
                </div>
            <% }) %>
        </div>

        <div class="cart">
            <h2>Cart</h2>
            <div id="cart-lines"></div>
            <div class="cart-line cart-total"><span>Total</span><span id="cart-total">$0.00</span></div>
            <button class="primary" style="width: 100%; margin-top: 1rem;" onclick="checkout()">Ring up sale</button>
            <div id="status"></div>
        </div>
    </div>

    <script>
        const cart = {}; // product_id -> { name, price_cents, quantity, stock_qty }

        function addToCart(id, name, priceCents, stockQty) {
            const existing = cart[id];
            const nextQty = (existing?.quantity ?? 0) + 1;
            if (nextQty > stockQty) {
                document.getElementById('status').textContent = `Only ${stockQty} of ${name} in stock.`;
                return;
            }
            cart[id] = { name, priceCents, quantity: nextQty, stockQty };
            renderCart();
        }

        function removeFromCart(id) {
            delete cart[id];
            renderCart();
        }

        function renderCart() {
            const linesEl = document.getElementById('cart-lines');
            linesEl.innerHTML = '';
            let total = 0;
            for (const [id, line] of Object.entries(cart)) {
                total += line.priceCents * line.quantity;
                const div = document.createElement('div');
                div.className = 'cart-line';
                div.innerHTML = `<span>${line.name} × ${line.quantity}</span><span>$${(line.priceCents * line.quantity / 100).toFixed(2)} <button onclick="removeFromCart(${id})">✕</button></span>`;
                linesEl.appendChild(div);
            }
            document.getElementById('cart-total').textContent = `$${(total / 100).toFixed(2)}`;
        }

        async function checkout() {
            const items = Object.entries(cart).map(([id, line]) => ({ product_id: Number(id), quantity: line.quantity }));
            if (items.length === 0) {
                document.getElementById('status').textContent = 'Cart is empty.';
                return;
            }
            const res = await fetch('/sales', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items }),
            });
            const data = await res.json();
            if (!res.ok) {
                document.getElementById('status').textContent = data.error || 'Sale failed.';
                return;
            }
            document.getElementById('status').textContent = `Sale #${data.saleId} completed — $${(data.totalCents / 100).toFixed(2)}`;
            for (const key of Object.keys(cart)) delete cart[key];
            renderCart();
            setTimeout(() => location.reload(), 1200);
        }
    </script>
</body>
</html>
