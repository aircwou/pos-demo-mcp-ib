# Neon Postgres connection string (pooled). No local DB container for this app.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Dex static client secret for the "pos-app" client (see
# dex-oidc-realestate-demo/dex/config.yaml.template).
POS_DEX_CLIENT_SECRET=

# Random secret for express-session cookie signing.
SESSION_SECRET=
